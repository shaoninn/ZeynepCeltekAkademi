# Zeynep Çeltek Güzellik Akademi — Environment

# Hostinger panelinde NODE_ENV mutlaka production olmalı (development yazma)
NODE_ENV="production"

# JWT_SECRET: production'da en az 32 karakter rastgele bir değer kullanın
JWT_SECRET="CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET_HERE"
NEXT_PUBLIC_SITE_URL="https://example.com"

# --- MySQL (Hostinger hPanel) ---
# Prefiks + ad: örn. u342414730_ZAKADEMI
# MYSQL_USER="uXXXX_ZAKADEMI"
# MYSQL_PASSWORD=""
# MYSQL_HOST="srvXXXX.hstgr.io"   # Remote MySQL — localhost değil
# MYSQL_PORT="3306"
# MYSQL_DATABASE="uXXXX_ZAKADEMI"
# 2 önerilir (process limiti yüksekse 1; SERIALIZE otomatik pool=1’de)
# MYSQL_POOL_SIZE="2"
# MYSQL_SERIALIZE="1"
# Seed / bootstrap (canlıda bir kez)
# ADMIN_EMAIL="admin@zeynepceltekakademi.local"
# ADMIN_PASSWORD="GucluSifre123"
# BOOTSTRAP_SECRET="rastgele-kurulum-anahtari"
# ALLOW_PROD_SEED="true"

# --- Medya işleme ---
# REMOVE_BG_API_KEY=""          # Opsiyonel Remove.bg (yoksa tarayıcıda WASM kullanılır)
# --- Instagram canlı feed (Meta Developer) ---
# INSTAGRAM_ACCESS_TOKEN=""
# INSTAGRAM_USER_ID=""
# Mail (opsiyonel)
# RESEND_API_KEY=""
# SMTP_URL=""
# MAIL_FROM="Zeynep Çeltek Güzellik Akademi <info@zeynepceltekakademi.local>"
# MAIL_MANUFACTURER="info@zeynepceltekakademi.local"
