# Zeynep Çeltek Güzellik Akademi — Environment
# Hostinger: DATABASE_URL eklemeyin.
# NODE_OPTIONS eklemeyin (düşük heap build’i OOM yapar). Build script 2048MB zorlar.

NODE_ENV=production
PORT=3000

JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET_HERE
NEXT_PUBLIC_SITE_URL=https://zeynepceltekakademi.com

# Opsiyonel e-posta (Resend veya SMTP)
# RESEND_API_KEY=
# MAIL_FROM=Zeynep Çeltek Güzellik Akademi <noreply@example.com>
# MAIL_FROM_NOTIFY=sahip@example.com
# SMTP_URL=smtps://user:pass@host:465

# Opsiyonel analitik / reklam (boşsa script yüklenmez; AW yedek kodda da var)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXX
NEXT_PUBLIC_AW_ID=AW-18472054951
# Dönüşüm etiketleri (Google Ads → Dönüşümler → Etiket ayrıntıları)
# NEXT_PUBLIC_AW_SEND_TO=AW-18472054951/XXXX
# NEXT_PUBLIC_AW_CONTACT_SEND_TO=AW-18472054951/YYYY
# NEXT_PUBLIC_META_PIXEL_ID=

MYSQL_USER=uXXXX_ZAKADEMI
MYSQL_PASSWORD=
MYSQL_HOST=srvXXXX.hstgr.io
MYSQL_PORT=3306
MYSQL_DATABASE=uXXXX_ZAKADEMI
MYSQL_POOL_SIZE=1
MYSQL_SERIALIZE=1
MYSQL_CONNECT_TIMEOUT_MS=20000
MYSQL_ACQUIRE_TIMEOUT_MS=25000
MYSQL_IDLE_TIMEOUT_MS=120000

# Opsiyonel build heap (varsayılan 2048)
# BUILD_MAX_OLD_SPACE_SIZE=2048

# PayTR iFrame API (kart ile kayıt ücreti)
# Panel bildirim URL: https://DOMAIN/api/payments/paytr/callback
# PAYTR_MERCHANT_ID=
# PAYTR_MERCHANT_KEY=
# PAYTR_MERCHANT_SALT=
# PAYTR_TEST_MODE=1
# PAYTR_UI_ENABLED=1
# veya Admin → Ayarlar → paytr_ui_enabled=1
