# PURGE_SECRET=
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_AW_ID=
# RESEND_API_KEY=
# SMTP_URL=
# MAIL_FROM=Zeynep Çeltek Güzellik Akademi <noreply@zeynepceltekakademi.com>
